{
  "name": "treningi",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // public/ wypełnia skrypt copy-assets.js (pliki aplikacji z katalogu głównego repozytorium)
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    // database_id wpisz po utworzeniu bazy: npx wrangler d1 create treningi
    { "binding": "DB", "database_name": "treningi", "database_id": "WSTAW-ID-BAZY" }
  ],
  "vars": { "APP_USER": "default" },
  "triggers": { "crons": ["0 3 * * *"] }
}
