{
  "name": "treningi",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // public/ wypełnia skrypt copy-assets.js (pliki aplikacji z katalogu głównego repozytorium)
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "treningi", "database_id": "5d4d585c-bee9-4b65-87d5-ef256bb0124f" }
  ],
  "vars": { "APP_USER": "default" },
  "triggers": { "crons": ["0 3 * * *"] }
}
